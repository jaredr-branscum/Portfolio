# -----------------------------------------------------------------------------
# Personal Portfolio Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to a new file named '.env' or '.env.local' in the project root
# to override these default options.
# -----------------------------------------------------------------------------

# The target email address to receive Contact form submissions
VITE_CONTACT_EMAIL=your.email@domain.com

# (Optional) Custom endpoint. If commented out/omitted, it automatically defaults
# to: https://free-email.service.co/${VITE_CONTACT_EMAIL}
#
# If you want to define it explicitly in this file referencing the email above, 
# use standard Vite/dotenv variable expansion syntax:
# VITE_CONTACT_ENDPOINT=https://free-email.service.co/${VITE_CONTACT_EMAIL}
